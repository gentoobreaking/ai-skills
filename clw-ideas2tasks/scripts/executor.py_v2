#!/usr/bin/env python3
from __future__ import annotations
"""
ideas2tasks executor.py
獨立工具：掃描 Ideas/ 建立 Tasks、GitHub Issue 同步、Status 格式統一

v3.0.0：預設模式直接掃描 Ideas/，不再依賴 lifecycle_status.json。

用法：
  python3 executor.py                        # 掃描 Ideas/，建立缺漏的 Tasks
  python3 executor.py --github               # 建 Tasks 後同步到 GitHub Issues + Board
  python3 executor.py --dry-run              # 預覽模式
  python3 executor.py --sync-github          # 直接掃 T*.md，建缺漏的 GitHub Issue
  python3 executor.py --normalize            # 統一 Tasks/ 的 Status 格式
"""

import argparse
import json
import re
import subprocess
import sys
import os
from datetime import datetime
from pathlib import Path

# 共用模組
sys.path.insert(0, str(Path(__file__).parent))
from state_sync import (
    TASKS_DIR, IDEAS_DIR,
    get_tasks_dir_status, read_task_status, write_task_status,
    should_skip_task, merge_classify_with_tasks_status,
    read_frontmatter_field,
)
from scan import scan_ideas
from classify import classify_idea

# 模板路徑
TEMPLATE_PATH = Path(__file__).parent.parent / "templates" / "task-template.md"

# GitHub 設定
GH_OWNER = "openclawchen8-lgtm"
GH_REPO  = "openclaw-tasks"
GH_PROJECT_ID = "PVT_kwHOD-tSg84BUX2a"
GH_PROJECT_NUMBER = 1

# Assignee → AgentId 映射
ASSIGNEE_MAP = {
    "寶寶": "main",
    "豪": "main",
    "豪（用戶）": "main",
    "碼農1號": "agent-coder1",
    "碼農 1 號": "agent-coder1",
    "碼農2號": "agent-coder2",
    "碼農 2 號": "agent-coder2",
    "安安": "agent-ann",
    "樂樂": "agent-lele",
    "研研": "agent-researcher",
}

# Board Status 欄位設定
BOARD_STATUS_FIELD_ID = "PVTSSF_lAHOD-tSg84BUX2azhBgcr0"
BOARD_STATUS_OPTIONS = {
    "pending": "f75ad846",
    "in-progress": "47fc9ee4",
    "done": "98236657",
    "skip": "20665cf0",
}


def _update_board_item_status(item_id: str, local_status: str) -> None:
    """設定 Board 上某個 item 的 Status 欄位。"""
    opt_id = BOARD_STATUS_OPTIONS.get(local_status)
    if not opt_id:
        return
    gql = (
        f"mutation{{updateProjectV2ItemFieldValue(input:{{"
        f"projectId:\"{GH_PROJECT_ID}\","
        f"itemId:\"{item_id}\","
        f"fieldId:\"{BOARD_STATUS_FIELD_ID}\","
        f"value:{{singleSelectOptionId:\"{opt_id}\"}}}}){{clientMutationId}}}}"
    )
    gh_gql(gql)


# ===== Task 建立（使用 template）=====

def load_template() -> str:
    """讀取 task-template.md，不存在則報錯。"""
    if not TEMPLATE_PATH.exists():
        print(f"❌ template 不存在: {TEMPLATE_PATH}", file=sys.stderr)
        sys.exit(1)
    return TEMPLATE_PATH.read_text(encoding="utf-8")


def create_task_file(task_dir: Path, task_num: int, task: dict) -> Path:
    """建立 task 檔案，優先使用 template。"""
    task_file = task_dir / f"T{task_num:03d}.md"
    now_str = datetime.now().strftime("%Y-%m-%d")

    tmpl = load_template()
    content = tmpl.format(
        title=task["title"][:50],
        status="pending",
        assignee=task["assignee"],
        created=now_str,
        updated=now_str,
        github="",
        num=f"{task_num:03d}",
        description=task.get("description", task["title"]),
    )
    task_file.write_text(content, encoding="utf-8")
    return task_file


def update_project_readme(project_dir: Path, project_name: str, tasks: list):
    """更新專案 README（使用 migrate_readme.py 會更好，此處為簡化版）。"""
    readme_file = project_dir / "README.md"

    tasks_status = get_tasks_dir_status(project_name)
    table_lines = ["| Task | 標題 | 負責人 | 優先級 | 狀態 |", "|------|------|--------|--------|------|"]

    for t in tasks:
        t_num = f"T{t['num']:03d}"
        status = tasks_status.get(t_num, t.get("status", "pending"))
        status_icon = "✅" if status == "done" else ("🔄" if status == "in-progress" else "⏳")
        table_lines.append(
            f"| {t_num} | {t['title'][:28]} | {t['assignee']} | {t['priority']} | {status_icon} |"
        )

    total = len(tasks)
    done = sum(1 for t in tasks if tasks_status.get(f"T{t['num']:03d}", "") == "done")

    content = f"""# {project_name} 專案

## 概述
由 ideas2tasks 自動建立的任務。

## Tasks 清單

{chr(10).join(table_lines)}

## 進度
- **完成**: {done}/{total}
- **進行中**: 0
- **待處理**: {total - done}

---

_建立日期: {datetime.now().strftime('%Y-%m-%d')}_
"""
    readme_file.write_text(content, encoding="utf-8")


def create_tasks_from_ideas(dry_run: bool = False) -> list:
    """
    直接掃描 Ideas/，分類後建立缺漏的 Tasks。
    不依賴 lifecycle_status.json。

    流程：scan_ideas() → classify_idea() → merge → 去重 → 建 T*.md
    """
    ideas = scan_ideas()
    if not ideas:
        print("  📭 無待處理 ideas")
        return []

    created = []
    for idea in ideas:
        # 分類
        raw_result = classify_idea(idea)
        merged = merge_classify_with_tasks_status(raw_result)

        # 無待處理 tasks → 跳過
        if merged.get("pending_count", 0) == 0:
            print(f"  ⏭️  {merged['project_name']}/ — 無待處理 tasks")
            continue

        project_name = merged["project_name"]
        project_dir = TASKS_DIR / project_name

        if not dry_run:
            project_dir.mkdir(exist_ok=True)
            (project_dir / "tasks").mkdir(exist_ok=True)

        tasks_info = []
        task_num = get_next_task_num(project_dir)
        extra_norm_set = set()

        for task in merged.get("tasks", []):
            task_desc = task.get("description", task.get("body", ""))
            skip, reason = should_skip_task(task["title"], project_dir, extra_norm_set, new_desc=task_desc)
            if skip:
                print(f"  🔄 {project_name}: 跳過「{task['title'][:40]}」— {reason}")
                continue

            task_info = {
                "num": task_num,
                "title": task["title"],
                "assignee": task["assignee"],
                "priority": task.get("priority", "Medium"),
                "category": task.get("category", "general"),
                "description": task.get("description", ""),
                "status": "pending",
            }

            if not dry_run:
                create_task_file(project_dir / "tasks", task_num, task_info)
                norm = task["title"].strip()
                norm = re.sub(r'^T\d+\s*[-–—:]\s*', '', norm)
                norm = re.sub(r'\d{4}[-/]\d{2}[-/]\d{2}', '', norm)
                norm = re.sub(r'https?://\S+', '', norm)
                norm = re.sub(r'[^\w\u4e00-\u9fff]', '', norm)
                norm = re.sub(r'\s+', '', norm).lower()
                extra_norm_set.add(norm)

            tasks_info.append(task_info)
            created.append({
                "project": project_name,
                "task_num": task_num,
                "title": task["title"],
                "assignee": task["assignee"],
                "agent_id": ASSIGNEE_MAP.get(task["assignee"], "main"),
            })
            task_num += 1

        if not dry_run and tasks_info:
            update_project_readme(project_dir, project_name, tasks_info)
            print(f"  📁 {project_name}/ — 建立 {len(tasks_info)} 個 tasks")
        elif dry_run and tasks_info:
            print(f"  📁 {project_name}/ — 將建立 {len(tasks_info)} 個 tasks")

    return created


def get_next_task_num(project_dir: Path) -> int:
    """取得專案下一個 task 編號"""
    tasks_dir = project_dir / "tasks"
    if not tasks_dir.exists():
        return 1
    existing = list(tasks_dir.glob("T*.md"))
    nums = [int(f.stem[1:]) for f in existing if f.stem[1:].isdigit()]
    return max(nums) + 1 if nums else 1


def build_telegram_report(created: list) -> str:
    """建立 Telegram 友善格式的報告"""
    if not created:
        return "✅ 無待處理 tasks"

    lines = ["✅ Tasks 已建立", ""]

    by_project = {}
    for c in created:
        by_project.setdefault(c["project"], []).append(c)

    for proj, tasks in by_project.items():
        lines.append(f"📁 {proj}/")
        for i, t in enumerate(tasks):
            prefix = "└─" if i == len(tasks) - 1 else "├─"
            lines.append(f"  {prefix} T{t['task_num']:03d} → {t['assignee']} (pending)")
        lines.append("")

    lines.append(f"📊 統計：建立 {len(created)} 個 tasks")
    return "\n".join(lines)


# ─────────────────────────────────────────
# GitHub 相關
# ─────────────────────────────────────────

def gh_run(cmd: str, timeout: int = 15) -> subprocess.CompletedProcess:
    """執行 gh CLI"""
    return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)


def gh_gql(query: str) -> dict:
    """執行 GitHub GraphQL query"""
    cmd = "gh api graphql --method POST --field 'query=" + query + "'"
    r = gh_run(cmd)
    if not r.stdout.strip():
        return {}
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return {}


def _humanize_issue_title(raw_title: str, max_len: int = 72) -> str:
    """將原始 task 標題轉為人類可讀的 GitHub Issue 標題。"""
    t = raw_title.strip()
    t = re.sub(r'https?://\S+', '', t)
    t = re.sub(r'\s+', ' ', t).strip()
    t = re.sub(r'^(請|幫我|請幫我|我要|需要|想要)\s*', '', t)
    if not t.strip():
        t = raw_title.strip()
    if len(t) > max_len:
        cut = max_len
        for sep in ['。', '？', '！', '；', '、', '，', '：', ' ']:
            pos = t.rfind(sep, 0, max_len)
            if pos > max_len // 2:
                cut = pos + 1
                break
        t = t[:cut].rstrip('，。、；：！？ ')
    if len(t) > max_len:
        t = t[:max_len - 1] + '…'
    return t


# ===== Task 建立（使用 template）=====
...
def _update_github_issue_url(task_md_path: Path, issue_url: str):
    """更新 T*.md frontmatter 的 github_issue 欄位"""
    content = task_md_path.read_text(encoding="utf-8")
    url_val = issue_url if issue_url else ""
    
    # 檢查是否已有 github_issue 欄位（無論是否有值）
    # Group 1 捕捉 Key 部分（包含可能的前導 - 或 ** 標記）
    pattern = r'^([- \t]*(\*+[ \t]*)?github_issue([ \t]*\*+)?[ \t]*:[ \t]*)(.*)'
    if re.search(pattern, content, re.IGNORECASE | re.MULTILINE):
        # 替換現有欄位，保留 Key 的格式（\1）
        content = re.sub(pattern, rf"\1{url_val}", content, flags=re.IGNORECASE | re.MULTILINE)
    else:
        # 插入新欄位到 frontmatter 頂部
        lines = content.splitlines()
        insert_pos = 0
        for i, line in enumerate(lines):
            if line.strip() == "---":
                insert_pos = i + 1
                break
        new_lines = lines[:insert_pos] + [f"github_issue: {url_val}"] + lines[insert_pos:]
        content = "\n".join(new_lines)
    task_md_path.write_text(content, encoding="utf-8")


def sync_single_task_to_github(proj: str, tid: str, task_md_path: Path) -> dict:
    """同步單一 T*.md 到 GitHub Issue。"""
    raw_body = task_md_path.read_text(encoding="utf-8")
    github_blob_url = (
        f"https://github.com/{GH_OWNER}/{GH_REPO}"
        f"/blob/main/{proj}/tasks/{tid}.md"
    )
    full_body = raw_body.strip() + f"\n\n---\n📂 GitHub: {github_blob_url}\n"

    body_file = f"/tmp/gh_body_{os.getpid()}_{tid}.txt"
    with open(body_file, "w") as f:
        f.write(full_body)

    raw_title = read_frontmatter_field(raw_body, "title") or tid
    raw_title = re.sub(r'^T\d{3}\s*—\s*', '', raw_title)
    title = f"[{proj}] {tid} — {_humanize_issue_title(raw_title)}"
    title_esc = title.replace('"', '\\"')

    cmd = (f'gh issue create --repo {GH_OWNER}/{GH_REPO}'
           f' --title "{title_esc}" --body-file {body_file}')
    r = gh_run(cmd)
    os.unlink(body_file)

    if r.returncode != 0:
        print(f"  ❌ {tid} 建立 Issue 失敗: {r.stderr[:80]}")
        return {"tid": tid, "issue_url": None, "added_to_board": False}

    m = re.search(r'/issues/(\d+)', r.stdout)
    issue_num = int(m.group(1)) if m else None
    issue_url = f"https://github.com/{GH_OWNER}/{GH_REPO}/issues/{issue_num}" if issue_num else None

    added_board = False
    if issue_num:
        node_cmd = f'gh api /repos/{GH_OWNER}/{GH_REPO}/issues/{issue_num} --jq .node_id'
        nr = gh_run(node_cmd)
        content_id = nr.stdout.strip().strip('"') if nr.returncode == 0 else None
        if content_id:
            gql = (f"mutation{{addProjectV2ItemById(input:{{projectId:\"{GH_PROJECT_ID}\","
                   f"contentId:\"{content_id}\"}}){{item{{id}}}}}}")
            d = gh_gql(gql)
            item_id = d.get("data", {}).get("addProjectV2ItemById", {}).get("item", {}).get("id")
            added_board = bool(item_id)
            if item_id:
                status = read_task_status(task_md_path)
                _update_board_item_status(item_id, status)

    _update_github_issue_url(task_md_path, issue_url)

    status_emoji = "✅" if added_board else "⚠️"
    print(f"  {status_emoji} {tid} → Issue #{issue_num} | Board: {'✅' if added_board else '❌'}")
    return {"tid": tid, "issue_url": issue_url, "added_to_board": added_board}


def sync_todos_to_github(dry_run: bool = False) -> list:
    """
    直接掃描 Tasks/ 下所有 T*.md，
    檢查 frontmatter 有無 github_issue:，缺則建立 GitHub Issue。
    """
    results = []
    tasks_dir = TASKS_DIR
    if not tasks_dir.exists():
        print("❌ Tasks 目錄不存在")
        return results

    done_dir = tasks_dir / "_done"
    t_files = []
    for proj_dir in sorted(tasks_dir.iterdir()):
        if not proj_dir.is_dir() or proj_dir == done_dir or proj_dir.name.startswith("_"):
            continue
        tasks_sub = proj_dir / "tasks"
        if not tasks_sub.exists():
            continue
        for tf in sorted(tasks_sub.glob("T*.md")):
            t_files.append((proj_dir.name, tf))

    print(f"\n🌐 GitHub Sync 模式：掃描 {len(t_files)} 個 T*.md...")

    for proj, tf in t_files:
        tid = tf.stem
        content = tf.read_text(encoding="utf-8")

        # 檢查是否已有 GitHub Issue URL
        existing_issue = read_frontmatter_field(content, "github_issue")
        if existing_issue.startswith("http"):
            print(f"  ⏭️  {proj}/{tid} — 已有 Issue URL，跳過")
            continue

        # 檢查任務狀態（使用 state_sync 的強健邏輯）
        status = read_task_status(tf)
        if status in ("done", "skip"):
            print(f"  ⏭️  {proj}/{tid} — status={status}，不建立 Issue")
            continue

        print(f"  → {proj}/{tid} — 建立 Issue...")
        if dry_run:
            print(f"     [DRY RUN] 將建立 Issue")
            results.append({"tid": tid, "issue_url": None, "added_to_board": False})
        else:
            r = sync_single_task_to_github(proj, tid, tf)
            results.append(r)

    return results


def _fetch_all_open_issues() -> dict[str, dict]:
    """一次取得所有 OPEN Issues，build 编号→URL 映射"""
    cmd = f'gh issue list --repo {GH_OWNER}/{GH_REPO} --state open --limit 200 --json number,url,title'
    r = gh_run(cmd, timeout=30)
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    try:
        issues = json.loads(r.stdout)
    except json.JSONDecodeError:
        return {}
    return {str(i["number"]): {"url": i["url"], "title": i["title"]} for i in issues}


def _title_similarity(a: str, b: str) -> float:
    from difflib import SequenceMatcher
    return SequenceMatcher(None, a, b).ratio()

def _normalize_for_match(title: str) -> str:
    """正規化標題用於比對"""
    t = title.strip()
    t = re.sub(r'^T\d+\s*[-–—:]\s*', '', t)
    t = re.sub(r'\d{4}[-/]\d{2}[-/]\d{2}', '', t)
    t = re.sub(r'https?://\S+', '', t)
    t = re.sub(r'[^\w\u4e00-\u9fff]', '', t)
    t = re.sub(r'\s+', '', t)
    return t.lower()


def _search_github_issue_by_task(proj: str, tid: str) -> str | None:
    """從 GitHub 搜尋對應的 Issue URL（標題包含 [proj] tid），不限狀態"""
    r = subprocess.run(
        ["gh", "search", "issues", f"[{proj}] {tid}",
         "--repo", f"{GH_OWNER}/{GH_REPO}",
         "--json", "url", "--limit", "5"],
        capture_output=True, text=True, timeout=10
    )
    if r.returncode != 0 or not r.stdout.strip():
        return None
    try:
        results = json.loads(r.stdout)
        if results and len(results) > 0:
            return results[0].get("url")
    except json.JSONDecodeError:
        pass
    return None


def _fetch_all_issues(state: str = "open") -> dict[str, dict]:
    """一次取得所有指定狀態的 Issues，build 编号→URL 映射"""
    cmd = f'gh issue list --repo {GH_OWNER}/{GH_REPO} --state {state} --limit 200 --json number,url,title'
    r = gh_run(cmd, timeout=30)
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    try:
        issues = json.loads(r.stdout)
    except json.JSONDecodeError:
        return {}
    return {str(i["number"]): {"url": i["url"], "title": i["title"]} for i in issues}


def _close_issue_thread(issue_url: str, status: str) -> bool:
    """在後台關閉 Issue"""
    comment = f"Closing issue as task is marked as '{status}' locally."
    close_cmd = f'gh issue close "{issue_url}" --comment "{comment}"'
    cr = gh_run(close_cmd, timeout=10)
    return cr.returncode == 0


def _create_github_issue(proj: str, tid: str, title: str, status: str = "done") -> str | None:
    """為任務建立 GitHub Issue + 加入 Board（若為 pending）並關閉"""
    issue_title = f"[{proj}] {tid} — {title[:72]}"
    issue_body = f"Task created from local file but not previously synced.\n\n> 本任務已標記為 {status}。"
    
    # 寫入 body 檔案
    body_file = f"/tmp/gh_body_create_{os.getpid()}_{tid}.txt"
    with open(body_file, "w") as f:
        f.write(issue_body)
    
    cmd = (f'gh issue create --repo {GH_OWNER}/{GH_REPO}'
           f' --title "{issue_title}" --body-file {body_file}')
    r = gh_run(cmd, timeout=15)
    os.unlink(body_file)
    
    if r.returncode != 0:
        return None
    
    m = re.search(r'/issues/(\d+)', r.stdout)
    if not m:
        return None
    
    issue_num = m.group(1)
    issue_url = f"https://github.com/{GH_OWNER}/{GH_REPO}/issues/{issue_num}"
    
    # 加入 Project Board
    node_cmd = f'gh api /repos/{GH_OWNER}/{GH_REPO}/issues/{issue_num} --jq .node_id'
    nr = gh_run(node_cmd)
    content_id = nr.stdout.strip().strip('"') if nr.returncode == 0 else None
    if content_id:
        gql = (f"mutation{{addProjectV2ItemById(input:{{projectId:\"{GH_PROJECT_ID}\","
               f"contentId:\"{content_id}\"}}){{item{{id}}}}}}")
        d = gh_gql(gql)
        item_id = d.get("data", {}).get("addProjectV2ItemById", {}).get("item", {}).get("id")
        if item_id:
            _update_board_item_status(item_id, status)
    
    # 立即關閉（done/skip 任務不需要保持 open）
    close_cmd = f'gh issue close {issue_num} -R {GH_OWNER}/{GH_REPO} --comment "任務已 {status}，自動同步。"'
    gh_run(close_cmd, timeout=10)
    
    return issue_url


def repair_github_issue_urls(dry_run: bool = False) -> list:
    """
    檢查並修補錯誤共用的 github_issue URL。
    當多個任務指向同一 Issue，或 URL 與任務不符時修補。
    """
    results = []
    tasks_dir = TASKS_DIR
    if not tasks_dir.exists():
        print("❌ Tasks 目錄不存在")
        return results

    print(f"\n🔧 GitHub Issue URL 修補模式...")

    # 取得 GitHub 所有 Issues
    r = subprocess.run(
        ["gh", "issue", "list", "--repo", f"{GH_OWNER}/{GH_REPO}",
         "--state", "all", "--limit", "500", "--json", "number,url,title"],
        capture_output=True, text=True, timeout=30
    )
    gh_issues = json.loads(r.stdout) if r.returncode == 0 else []
    gh_url_to_info = {i["url"]: i for i in gh_issues}

    # 收集所有任務並建立 URL → 任務列表映射
    from collections import defaultdict
    from state_sync import read_task_title
    
    url_to_tasks = defaultdict(list)
    for proj_dir in sorted(tasks_dir.iterdir()):
        if not proj_dir.is_dir() or proj_dir.name.startswith("_"):
            continue
        tasks_sub = proj_dir / "tasks"
        if not tasks_sub.exists():
            continue
        for tf in sorted(tasks_sub.glob("T*.md")):
            content = tf.read_text(encoding="utf-8")
            url = read_frontmatter_field(content, "github_issue")
            if url and url.startswith("http"):
                url_to_tasks[url].append((proj_dir.name, tf))

    # 初始共用 URL 集合（出現次數 > 1）
    shared_urls = {url for url, lst in url_to_tasks.items() if len(lst) > 1}
    print(f"  📋 發現 {len(shared_urls)} 個共用 URL（需要檢查）")

    fixed_count = 0
    # 我們需要遍歷一份快照，因為迴圈內會修改 url_to_tasks
    snapshot = []
    for url, lst in url_to_tasks.items():
        for proj, tf in lst:
            snapshot.append((proj, tf, url))

    for proj, tf, url in snapshot:
        tid = tf.stem
        title = read_task_title(tf)

        # 只處理當前仍被標記為共用的 URL
        if url not in shared_urls:
            continue

        # 取得 Issue 資訊
        issue_info = gh_url_to_info.get(url, {})
        issue_title = issue_info.get("title", "")
        issue_num = issue_info.get("number", "")

        # 判斷是否需要修補：標題要包含正確的 proj 和 tid
        needs_fix = not issue_title or proj not in issue_title or tid not in issue_title

        if needs_fix:
            print(f"  ⚠️ {proj}/{tid} → URL 指向錯誤 Issue #{issue_num}")
            
            found = None
            # 嘗試搜尋正確的 Issue
            found = _search_github_issue_by_task(proj, tid)
            
            if not found:
                # 搜尋 tid（不帶專案），但要驗證專案名稱
                r = subprocess.run(
                    ["gh", "search", "issues", tid,
                     "--repo", f"{GH_OWNER}/{GH_REPO}",
                     "--json", "url,title", "--limit", "5"],
                    capture_output=True, text=True, timeout=10
                )
                if r.returncode == 0 and r.stdout.strip():
                    try:
                        results_j = json.loads(r.stdout)
                        for res in results_j:
                            # 只接受標題包含正確專案名稱的結果
                            if proj in res.get("title", ""):
                                found = res.get("url")
                                break
                    except json.JSONDecodeError:
                        pass

            if not found:
                status = read_task_status(tf)
                print(f"     建立新 Issue...")
                found = _create_github_issue(proj, tid, title, status)

            if found:
                print(f"     ✅ → {found}")
                if not dry_run:
                    _update_github_issue_url(tf, found)
                # 更新映射：從舊 URL 移除當前任務
                url_to_tasks[url].remove((proj, tf))
                if not url_to_tasks[url]:
                    # 該舊 URL 已無任務引用，從共用集合中移除
                    shared_urls.discard(url)
                # 加入新 URL 映射
                url_to_tasks[found].append((proj, tf))
                if len(url_to_tasks[found]) > 1:
                    # 新 URL 現在被多個任務共用，加入共用集合
                    shared_urls.add(found)
                fixed_count += 1
                results.append({"tid": tid, "old_url": url, "new_url": found})
            else:
                print(f"     ❌ 無法修補")

    print(f"\n✅ 完成：修補 {fixed_count} 個 URL")

    # ── 清理孤兒 Issue（已關閉且無本地任務對應）──
    print(f"\n  🧹 檢查孤兒 Issue...")
    # 重新掃描本地所有 task 的 URL（修補後可能已更新）
    active_urls = set()
    for proj_dir in sorted(tasks_dir.iterdir()):
        if not proj_dir.is_dir() or proj_dir.name.startswith("_"):
            continue
        tasks_sub = proj_dir / "tasks"
        if not tasks_sub.exists():
            continue
        for tf in sorted(tasks_sub.glob("T*.md")):
            url = read_frontmatter_field(tf.read_text(encoding="utf-8"), "github_issue")
            if url and url.startswith("http"):
                active_urls.add(url)

    # 重新取得 GitHub 所有 Issues（修補後可能新增了）
    r = subprocess.run(
        ["gh", "issue", "list", "--repo", f"{GH_OWNER}/{GH_REPO}",
         "--state", "all", "--limit", "500", "--json", "number,url,title,state"],
        capture_output=True, text=True, timeout=30
    )
    all_gh = json.loads(r.stdout) if r.returncode == 0 else []
    orphans = [i for i in all_gh if i["url"] not in active_urls]
    print(f"  📋 發現 {len(orphans)} 個孤兒 Issue（無對應任務）")

    if dry_run:
        print("  （略過）" if orphans else "")
        return results

    deleted = 0
    skipped = 0
    for issue in orphans:
        num = issue["number"]
        info = subprocess.run(
            ["gh", "api", f"repos/{GH_OWNER}/{GH_REPO}/issues/{num}",
             "--jq", ".comments"],
            capture_output=True, text=True, timeout=10
        )
        has_comments = info.stdout.strip() not in ("", "0") if info.returncode == 0 else False

        if has_comments:
            print(f"    ⏭️  Issue #{num} 有 {info.stdout.strip()} 則 comment，無法刪除")
            skipped += 1
            continue

        print(f"    🗑️  刪除 Issue #{num}...", end="")
        r2 = subprocess.run(
            ["gh", "api", "-X", "DELETE",
             f"repos/{GH_OWNER}/{GH_REPO}/issues/{num}"],
            capture_output=True, text=True, timeout=15
        )
        if r2.returncode == 0:
            print(" ✅")
            deleted += 1
        else:
            print(f" ❌ ({r2.stderr.strip()})")

    if deleted or skipped:
        print(f"\n  ✅ 已刪除 {deleted} 個，{skipped} 個因有 comment 略過")
    else:
        print(f"  （無孤兒 Issue）")

    return results


def cleanup_github_issues(dry_run: bool = False) -> list:
    results = []
    tasks_dir = TASKS_DIR
    if not tasks_dir.exists():
        print("❌ Tasks 目錄不存在")
        return results

    # 一次取得所有 OPEN Issues
    print(f"\n🧹 GitHub Cleanup 模式...")
    open_issues = _fetch_all_issues("open")
    print(f"  📋 OPEN Issues: {len(open_issues)} 個")

    # 收集 done/skip 任務
    done_dir = tasks_dir / "_done"
    done_tasks = []  # (proj, tf, issue_url)
    missing_issue = []  # (proj, tf, tid, title)

    for proj_dir in sorted(tasks_dir.iterdir()):
        if not proj_dir.is_dir() or proj_dir == done_dir or proj_dir.name.startswith("_"):
            continue
        tasks_sub = proj_dir / "tasks"
        if not tasks_sub.exists():
            continue
        for tf in sorted(tasks_sub.glob("T*.md")):
            status = read_task_status(tf)
            if status not in ("done", "skip"):
                continue
            content = tf.read_text(encoding="utf-8")
            issue_url = read_frontmatter_field(content, "github_issue")
            if issue_url and issue_url.startswith("http"):
                done_tasks.append((proj_dir.name, tf, issue_url))
            else:
                from state_sync import read_task_title
                title = read_task_title(tf)
                missing_issue.append((proj_dir.name, tf, tf.stem, title))

    print(f"  📋 done/skip: {len(done_tasks)} 個（有 URL），{len(missing_issue)} 個（缺 URL）")

    # 缺 URL → 策略 1→2→3→4
    if missing_issue:
        print(f"  🔍 搜尋 {len(missing_issue)} 個任務...")
        for proj, tf, tid, title in missing_issue:
            found = None

# 策略 1: gh search "[proj] T###"
            if not found:
                found = _search_github_issue_by_task(proj, tid)

            # 策略 2: gh search "T###"（無專案前綴）
            if not found:
                r = subprocess.run(
                    ["gh", "search", "issues", tid,
                     "--repo", f"{GH_OWNER}/{GH_REPO}",
                     "--json", "url", "--limit", "5"],
                    capture_output=True, text=True, timeout=10
                )
                if r.returncode == 0 and r.stdout.strip():
                    try:
                        results_j = json.loads(r.stdout)
                        if results_j:
                            found = results_j[0].get("url")
                    except json.JSONDecodeError:
                        pass

            # 策略 3: 建立新 Issue
            if not found:
                status = read_task_status(tf)
                print(f"     ⚠️ {proj}/{tid} 找不到，建立新 Issue...")
                found = _create_github_issue(proj, tid, title, status)

            if found:
                print(f"     📎 {proj}/{tid} → {found}")
                done_tasks.append((proj, tf, found))
                if not dry_run:
                    _update_github_issue_url(tf, found)
            else:
                print(f"     ❌ {proj}/{tid} 無法處理")

    # 比對 open_issues → 找出要關閉的
    to_close = []
    for proj, tf, issue_url in done_tasks:
        m = re.search(r'/issues/(\d+)', issue_url)
        if not m:
            continue
        issue_num = m.group(1)
        if issue_num in open_issues:
            to_close.append((proj, tf, issue_url))
            del open_issues[issue_num]

    print(f"  📋 需要關閉：{len(to_close)} 個")

    if dry_run:
        for proj, tf, issue_url in to_close:
            print(f"     [DRY RUN] 將關閉 {issue_url}")
        print(f"\n✅ [DRY RUN] 預計關閉 {len(to_close)} 個")
        return [{"tid": tf.stem, "issue_url": u, "closed": False} for _, tf, u in to_close]

    # 取得 Board 上所有項目的 item_id（用於後續更新 Status）
    print(f"  📋 查詢 Board 項目...")
    board_item_map = {}
    gql = (
        f"query{{node(id:\"{GH_PROJECT_ID}\"){{... on ProjectV2{{"
        f"items(first:500){{nodes{{id content{{... on Issue{{number}}}}}}}}}}}}}}"
    )
    r = subprocess.run(
        ["gh", "api", "graphql", "-f", f"query={gql}"],
        capture_output=True, text=True, timeout=30
    )
    if r.returncode == 0 and r.stdout.strip():
        try:
            d = json.loads(r.stdout)
            for item in d.get("data", {}).get("node", {}).get("items", {}).get("nodes", []):
                if item.get("content") and item["content"].get("number"):
                    board_item_map[str(item["content"]["number"])] = item["id"]
            print(f"  📋 Board 項目: {len(board_item_map)} 個")
        except (json.JSONDecodeError, AttributeError, KeyError):
            print(f"  ⚠️ 無法解析 Board 資料")

    # 關閉
    closed_count = 0
    for proj, tf, issue_url in to_close:
        status = read_task_status(tf)
        if _close_issue_thread(issue_url, status):
            print(f"     ✅ {proj}/{tf.stem} 已關閉")
            closed_count += 1
        else:
            print(f"     ❌ {proj}/{tf.stem} 關閉失敗")
        m2 = re.search(r'/issues/(\d+)', issue_url)
        if m2:
            item_id = board_item_map.get(m2.group(1))
            if item_id:
                _update_board_item_status(item_id, status)
        results.append({"tid": tf.stem, "issue_url": issue_url, "closed": closed_count > 0})

    print(f"\n✅ 完成：已關閉 {closed_count}/{len(to_close)} 個 Issue")
    return results



def pull_github_issues_to_local(dry_run: bool = False) -> list:
    """
    掃描 GitHub 上最近關閉的 Issue，如果對應的本地任務存在且狀態不是 done，則更新其狀態為 done。
    """
    results = []
    tasks_dir = TASKS_DIR
    if not tasks_dir.exists():
        print("❌ Tasks 目錄不存在")
        return results

    # 獲取最近關閉的 Issue，限制為 100 以避免過多請求
    print(f"\n🔄 GitHub Pull 模式：獲取最近關閉的 Issue...")
    list_cmd = f'gh issue list --repo {GH_OWNER}/{GH_REPO} --state closed --limit 100 --json number,title,state,url'
    lr = gh_run(list_cmd)
    if lr.returncode != 0:
        print(f"❌ 獲取 GitHub Issue 失敗: {lr.stderr[:200]}")
        return results

    try:
        issues = json.loads(lr.stdout)
        if not isinstance(issues, list):
            print(f"❌ GitHub 返回的數據格式不正確")
            return results
    except json.JSONDecodeError as e:
        print(f"❌ 解析 GitHub Issue 列表失敗: {e}")
        return results

    print(f"  找到 {len(issues)} 個關閉的 Issue")

    for issue in issues:
        issue_number = issue.get("number")
        issue_title = issue.get("title", "")
        issue_url = issue.get("url", "")

        if not issue_number or not issue_title:
            continue

        # 解析 Issue 標題以提取專案名稱和任務編號
        # 期望格式：[proj] T001 -- 描述 或者類似
        # 我們的標題構建方式是: f"[{proj}] {tid} — {_humanize_issue_title(raw_title)}"
        # 所以我們可以嘗試匹配類似 "[anything] T001 —" 的模式
        import re
        match = re.search(r'\[([^\]]+)\]\s*(T\d+)', issue_title)
        if not match:
            # 如果沒有匹配到標準格式，嘗試其他可能的格式
            # 例如有些可能沒有方括號
            match = re.search(r'(T\d+)', issue_title)
            if match:
                # 只有任務編號，則需要遍歷所有專案來找到對應的任務文件
                project_name = None
                task_id = match.group(1)
            else:
                continue  # 無法提取任務編號，跳過
        else:
            project_name = match.group(1)
            task_id = match.group(2)  # 例如 T001

        # 確定任務文件路徑
        if project_name:
            # 如果我們從標題中提取到了專案名稱
            task_file = tasks_dir / project_name / "tasks" / f"{task_id}.md"
        else:
            # 如果只有任務編號，則需要在所有專案中查找
            task_file = None
            for proj_dir in tasks_dir.iterdir():
                if proj_dir.is_dir() and not proj_dir.name.startswith("_"):
                    candidate = proj_dir / "tasks" / f"{task_id}.md"
                    if candidate.exists():
                        task_file = candidate
                        project_name = proj_dir.name
                        break
            if not task_file:
                # 找不到對應的任務文件
                print(f"  ⚠️ Issue #{issue_number}: 未找到對應的本地任務文件 (任務編號: {task_id})")
                results.append({
                    "issue_number": issue_number,
                    "issue_url": issue_url,
                    "task_id": task_id,
                    "updated": False,
                    "reason": "task file not found"
                })
                continue

        # 檢查任務文件是否存在
        if not task_file.exists():
            print(f"  ⚠️ Issue #{issue_number}: 任務文件不存在 {task_file}")
            results.append({
                "issue_number": issue_number,
                "issue_url": issue_url,
                "task_id": task_id,
                "project": project_name if 'project_name' in locals() else None,
                "updated": False,
                "reason": "task file not found"
            })
            continue

        # 讀取當前任務狀態
        current_status = read_task_status(task_file)
        if current_status == "done":
            # 任務已經是 done，無需更新
            print(f"  ⏭️  Issue #{issue_number}: 任務 {task_id} 已經是 done，跳過")
            results.append({
                "issue_number": issue_number,
                "issue_url": issue_url,
                "task_id": task_id,
                "project": project_name if 'project_name' in locals() else task_file.parent.parent.name,
                "updated": False,
                "reason": "already done"
            })
            continue

        # 更新任務狀態為 done
        print(f"  → Issue #{issue_number}: 將任務 {task_id} 的狀態從 {current_status} 更新為 done")
        if dry_run:
            results.append({
                "issue_number": issue_number,
                "issue_url": issue_url,
                "task_id": task_id,
                "project": project_name if 'project_name' in locals() else task_file.parent.parent.name,
                "updated": True,
                "dry_run": True
            })
        else:
            # 使用 state_sync 中的函數更新狀態
            write_task_status(task_file, "done")
            # 同時更新 updated 欄位為今天的日期
            from datetime import datetime
            today_str = datetime.now().strftime("%Y-%m-%d")
            # 我們需要更新 frontmatter 中的 updated 欄位
            content = task_file.read_text(encoding="utf-8")
            # 更新 updated 欄位
            updated_pattern = r'^([- \t]*(\*+[ \t]*)?updated([ \t]*\*+)?[ \t]*:[ \t]*).+'
            if re.search(updated_pattern, content, re.IGNORECASE | re.MULTILINE):
                content = re.sub(updated_pattern, rf"\1{today_str}", content, flags=re.IGNORECASE | re.MULTILINE)
            else:
                # 如果沒有 updated 欄位，則在 frontmatter 中添加
                # 假設 frontmatter 結構是 --- 分隔的
                lines = content.splitlines()
                new_lines = []
                in_frontmatter = False
                inserted = False
                for line in lines:
                    stripped = line.strip()
                    if stripped == "---":
                        if not in_frontmatter:
                            in_frontmatter = True
                            new_lines.append(line)
                        else:
                            in_frontmatter = False
                            # 在關閉的 frontmatter 前插入 updated 行
                            new_lines.append(f"- **Updated**: {today_str}")
                            new_lines.append(line)
                            inserted = True
                    else:
                        if in_frontmatter and not inserted and stripped.startswith("- **Assignee**"):
                            # 在 Assignee 後插入 Updated
                            new_lines.append(line)
                            new_lines.append(f"- **Updated**: {today_str}")
                            inserted = True
                        else:
                            new_lines.append(line)
                if not inserted:
                    # 如果仍未插入，則在 frontmatter 結尾前添加
                    # 找到第二個 --- 的位置
                    for i, line in enumerate(new_lines):
                        if line.strip() == "---":
                            # 這是結尾的 ---，在它前插入
                            new_lines.insert(i, f"- **Updated**: {today_str}")
                            break
                    else:
                        # 如果找不到結尾的 ---（不應該發生），則添加到末尾
                        new_lines.append(f"- **Updated**: {today_str}")
                content = "\n".join(new_lines)
            task_file.write_text(content, encoding="utf-8")
            results.append({
                "issue_number": issue_number,
                "issue_url": issue_url,
                "task_id": task_id,
                "project": project_name if 'project_name' in locals() else task_file.parent.parent.name,
                "updated": True,
                "dry_run": False
            })

    return results


def _normalize_title(title: str) -> str:
    """正規化標題"""
    t = title.strip()
    t = re.sub(r'^T\d+\s*[-–—:]\s*', '', t)
    t = re.sub(r'\d{4}[-/]\d{2}[-/]\d{2}', '', t)
    t = re.sub(r'https?://\S+', '', t)
    t = re.sub(r'[^\w一-鿿]', '', t)
    t = re.sub(r'\s+', '', t)
    return t.lower()

def _title_similarity(a: str, b: str) -> float:
    from difflib import SequenceMatcher
    return SequenceMatcher(None, a, b).ratio()

def reverse_sync(dry_run: bool = False) -> list:
    """反向同步：從 OPEN GitHub Issues 比對本地 done/skip 任務，關閉匹配的 Issue"""
    results = []
    tasks_dir = TASKS_DIR
    
    # 1. 取得所有 OPEN 的 GitHub Issues
    print("\n🔄 反向同步模式：掃描 OPEN GitHub Issues...")
    open_cmd = f'gh issue list --repo {GH_OWNER}/{GH_REPO} --state open --limit 100 --json number,title,state'
    orun = gh_run(open_cmd)
    if orun.returncode != 0:
        print(f"❌ 獲取 OPEN Issue 失敗: {orun.stderr[:200]}")
        return results
    
    try:
        open_issues = json.loads(orun.stdout)
    except json.JSONDecodeError:
        print("❌ 解析 GitHub Issue 列表失敗")
        return results
    
    print(f"  📋 找到 {len(open_issues)} 個 OPEN Issues")
    
    # 2. 取得所有本地 done/skip 任務
    task_map = {}
    all_tasks = []
    
    for proj_dir in sorted(tasks_dir.iterdir()):
        if not proj_dir.is_dir() or proj_dir.name.startswith("_"):
            continue
        tasks_sub = proj_dir / "tasks"
        if not tasks_sub.exists():
            continue
        
        for task_file in sorted(tasks_sub.glob("T*.md")):
            status = read_task_status(task_file)
            if status not in ("done", "skip"):
                continue
            
            from state_sync import read_task_title
            title = read_task_title(task_file)
            
            task_info = {
                "project": proj_dir.name,
                "task_id": task_file.stem,
                "status": status,
                "title": title,
                "norm_title": _normalize_title(title),
                "filepath": str(task_file),
            }
            
            key = f"{proj_dir.name}/{task_file.stem}".lower()
            task_map[key] = task_info
            all_tasks.append(task_info)
    
    print(f"  📋 找到 {len(task_map)} 個本地 done/skip 任務")
    
    # 3. 比對並關閉
    closed = []
    errors = []
    
    for issue in open_issues:
        issue_num = issue.get("number")
        issue_title = issue.get("title", "")
        norm_issue = _normalize_title(issue_title)
        
        matched_task = None
        proj_name = ""
        
        # 策略 1: key 匹配
        match = re.match(r'^\[([^\]]+)\]\s*(T\d+[-\w]*)', issue_title)
        if match:
            proj_name = match.group(1)
            task_n = match.group(2)
            key = f"{proj_name.lower()}/{task_n.lower()}"
            if key in task_map:
                matched_task = task_map[key]
        else:
            proj_name = ""
        
        # 策略 2: 正規化標題匹配
        if not matched_task and proj_name:
            for t in all_tasks:
                if t["norm_title"] == norm_issue and t["project"].lower() == proj_name.lower():
                    matched_task = t
                    break
        
        # 策略 3: 相似度匹配
        if not matched_task and proj_name:
            best_match = None
            best_score = 0
            for t in all_tasks:
                if t["project"].lower() != proj_name.lower():
                    continue
                score = _title_similarity(norm_issue, t["norm_title"])
                if score > best_score:
                    best_score = score
                    best_match = t
            if best_score > 0.85:
                matched_task = best_match
        
        if not matched_task:
            continue
        
        # 關閉 Issue
        print(f"  → Issue #{issue_num} → {matched_task['project']}/{matched_task['task_id']} (matched)")
        
        if not dry_run:
            status_text = matched_task["status"]
            close_cmd = f'gh issue close {issue_num} -R {GH_OWNER}/{GH_REPO} --comment "本地任務已 {status_text}，自動關閉"'
            crun = gh_run(close_cmd)
            if crun.returncode == 0:
                closed.append(issue_num)
                print(f"    ✅ 已關閉")
            else:
                errors.append(issue_num)
                print(f"    ❌ 關閉失敗")
        else:
            closed.append(issue_num)
    
    print(f"\n📊 反向同步結果：")
    print(f"  ✅ 關閉: {len(closed)} 個")
    print(f"  ❌ 失敗: {len(errors)} 個")
    
    return results


def sync_board(dry_run: bool = False) -> list:
    """
    將 GitHub Issues 與 Project Board 同步。
    找出在 GitHub 上存在但未加入 Board 的 Issues，並將其加入 Board。
    """
    results = []

    # 1. 取得所有 Board Items
    all_items = []
    cursor = None
    for _ in range(10):
        after_arg = f', after: "{cursor}"' if cursor else ''
        query = f'''{{
          node(id: "{GH_PROJECT_ID}") {{
            ... on ProjectV2 {{
              items(first: 100{after_arg}) {{
                pageInfo {{ hasNextPage endCursor }}
                nodes {{ id content {{ ... on Issue {{ number }} }}
                  fieldValues(first: 10) {{ nodes {{ ... on ProjectV2ItemFieldSingleSelectValue {{
                    name field {{ ... on ProjectV2SingleSelectField {{ name }} }}
                  }} }} }}
                }}
              }}
            }}
          }}
        }}'''
        r = subprocess.run(["gh", "api", "graphql", "-f", f"query={query}"], capture_output=True, text=True)
        if r.returncode != 0:
            print(f"❌ 取得 Board 失敗: {r.stderr[:200]}")
            return results
        data = json.loads(r.stdout)
        items = data["data"]["node"]["items"]["nodes"]
        all_items.extend(items)
        page_info = data["data"]["node"]["items"]["pageInfo"]
        if not page_info["hasNextPage"]:
            break
        cursor = page_info["endCursor"]

    board_nums = set()
    for item in all_items:
        if item["content"]:
            board_nums.add(item["content"]["number"])

    # 2. 取得所有 GitHub Issues
    r = subprocess.run(
        ["gh", "issue", "list", "--repo", f"{GH_OWNER}/{GH_REPO}", "--state", "all", "--limit", "500", "--json", "number,state"],
        capture_output=True, text=True
    )
    if r.returncode != 0:
        print(f"❌ 取得 GitHub Issues 失敗: {r.stderr[:200]}")
        return results
    gh_issues = json.loads(r.stdout)
    gh_nums = set(i["number"] for i in gh_issues)
    gh_state_map = {str(i["number"]): i["state"] for i in gh_issues}

    # 3. 建立 local task status 對照表 (issue_number → local_status)
    local_status_map = {}
    for proj_dir in sorted(TASKS_DIR.iterdir()):
        if not proj_dir.is_dir() or proj_dir.name.startswith("_"):
            continue
        tasks_sub = proj_dir / "tasks"
        if not tasks_sub.exists():
            continue
        for tf in sorted(tasks_sub.glob("T*.md")):
            content = tf.read_text(encoding="utf-8")
            url = read_frontmatter_field(content, "github_issue")
            if url and url.startswith("http"):
                m = re.search(r'/issues/(\d+)', url)
                if m:
                    local_status_map[m.group(1)] = read_task_status(tf)

    # 4. 找出 orphan issues
    orphan_nums = gh_nums - board_nums
    if not orphan_nums:
        print(f"\n✅ Board 已同步：{len(board_nums)} 個 Issues 全部在 Board 上")
    else:
        print(f"\n🔧 Board 同步：發現 {len(orphan_nums)} 個未在 Board 上的 Issues")
        print(f"  Board: {len(board_nums)} 個 | GitHub: {len(gh_nums)} 個 | Orphan: {len(orphan_nums)} 個")

        added = 0
        failed = 0
        for num in sorted(orphan_nums):
            r = subprocess.run(["gh", "api", f"/repos/{GH_OWNER}/{GH_REPO}/issues/{num}"], capture_output=True, text=True)
            if r.returncode != 0:
                print(f"  ⚠️  #{num}: GitHub 上已刪除或無法訪問")
                failed += 1
                continue

            issue = json.loads(r.stdout)
            node_id = issue["node_id"]
            state = issue["state"]
            title = issue["title"][:50]

            if dry_run:
                print(f"  ⏭️  #{num} [{state}]: {title} (dry-run)")
                results.append({"issue_number": num, "state": state, "title": title, "added": False})
                continue

            query = f'''
            mutation {{
              addProjectV2ItemById(input: {{ projectId: "{GH_PROJECT_ID}", contentId: "{node_id}" }}) {{
                item {{ id }}
              }}
            }}
            '''
            mr = subprocess.run(["gh", "api", "graphql", "-f", f"query={query}"], capture_output=True, text=True)
            if mr.returncode == 0:
                try:
                    item_id = json.loads(mr.stdout).get("data", {}).get("addProjectV2ItemById", {}).get("item", {}).get("id")
                    if item_id:
                        board_status = "done" if state == "closed" else "pending"
                        _update_board_item_status(item_id, board_status)
                except json.JSONDecodeError:
                    pass
                print(f"  ✅ #{num} [{state}]: {title}")
                added += 1
            else:
                print(f"  ❌ #{num}: {mr.stderr[:80]}")
                failed += 1
                continue

            results.append({"issue_number": num, "state": state, "title": title, "added": True})

        print(f"\n✅ 完成：已加入 Board {added} 個，失敗 {failed} 個")

    # 5. 校正 Board 項目 Status（只修本地與 Board 不一致的）
    print(f"\n🎯 檢查 Board 項目 Status...")
    board_current = {}
    for item in all_items:
        issue = item.get("content")
        if not issue:
            continue
        num = str(issue["number"])
        status_val = ""
        for fv in item.get("fieldValues", {}).get("nodes", []):
            if isinstance(fv, dict) and fv.get("field", {}).get("name") == "Status":
                status_val = fv.get("name", "")
                break
        board_current[num] = {"item_id": item["id"], "board_status": status_val}

    fixed = 0
    for num, info in board_current.items():
        local_status = local_status_map.get(num)
        if not local_status:
            continue
        expected_board = {"done": "Done", "skip": "Skipped", "pending": "Pending", "in-progress": "In Progress"}.get(local_status, "")
        if not expected_board or info["board_status"] == expected_board:
            continue
        _update_board_item_status(info["item_id"], local_status)
        fixed += 1

    if fixed:
        print(f"  ✅ 已校正 {fixed} 個 Board 項目的 Status")
    else:
        print(f"  ✅ 全部一致，無需校正")
    return results


def sync_tasks_to_github(created: list) -> list:
    """將新建立的 tasks 同步到 GitHub Issues + Board。"""
    results = []
    for c in created:
        proj = c["project"]
        tnum = c["task_num"]
        tid = f"T{tnum:03d}"
        task_md_path = TASKS_DIR / proj / "tasks" / f"{tid}.md"

        if not task_md_path.exists():
            print(f"  ⚠️ 找不到 {task_md_path}，跳過")
            continue

        # 使用共用函式簡化邏輯
        r = sync_single_task_to_github(proj, tid, task_md_path)
        r["task_num"] = tnum # 相容原本回傳格式
        results.append(r)

    return results


# ===== Main =====

def main():
    parser = argparse.ArgumentParser(description="ideas2tasks executor")
    parser.add_argument("--no-spawn", action="store_true", help="只建立 tasks，不 spawn agents")
    parser.add_argument("--dry-run", action="store_true", help="乾跑模式")
    parser.add_argument("--normalize", action="store_true", help="執行前先統一所有 Tasks/ 的 Status 格式")
    parser.add_argument("--github", action="store_true",
                        help="建 Tasks 後同步到 GitHub Issues + Board")
    parser.add_argument("--sync-github", action="store_true",
                        help="直接掃 T*.md 建立缺漏的 GitHub Issue（不掃 Ideas）")
    parser.add_argument("--cleanup-github", action="store_true",
                        help="關閉已完成/已跳過任務的 GitHub Issue")
    parser.add_argument("--repair-github", action="store_true",
                        help="修補錯誤共用的 github_issue URL")
    parser.add_argument("--sync-board", action="store_true",
                        help="將 GitHub Issues 同步到 Project Board（補加入 Board）")
    parser.add_argument("--reverse-only", action="store_true",
                         help="從 GitHub 驅動，掃描 OPEN Issue → 找到本地 done/skip → 關閉 GitHub Issue")
    parser.add_argument("--pull-github", action="store_true",
                         help="從 GitHub 拉取關閉的 Issue 並更新本地任務狀態")
    args = parser.parse_args()

    # ── 獨立模式：--sync-github（只同步 GitHub，不掃 Ideas）──────────────
    if args.sync_github:
        print("🚀 executor.py — GitHub Sync 模式（直接讀 T*.md）")
        results = sync_todos_to_github(dry_run=args.dry_run)
        ok = sum(1 for r in results if r["issue_url"])
        print(f"\n✅ 完成：{ok}/{len(results)} 個 Issue 已建立/已存在")
        return

    # ── 獨立模式：--reverse-only ──────────────
    if args.reverse_only:
        print("🚀 executor.py — 反向同步模式")
        reverse_sync(dry_run=args.dry_run)
        return

    # ── 獨立模式：--cleanup-github ──────────────
    if args.cleanup_github:
        print("🚀 executor.py — GitHub Cleanup 模式")
        results = cleanup_github_issues(dry_run=args.dry_run)
        closed = sum(1 for r in results if r["closed"])
        if args.dry_run:
            print(f"\n✅ [DRY RUN] 預計將關閉 {len(results)} 個 Issue")
        else:
            print(f"\n✅ 完成：已關閉 {closed}/{len(results)} 個 Issue")
        return

    # ── 獨立模式：--repair-github ──────────────
    if args.repair_github:
        print("🚀 executor.py — GitHub URL 修補模式")
        results = repair_github_issue_urls(dry_run=args.dry_run)
        if args.dry_run:
            print(f"\n✅ [DRY RUN] 預計將修補 {len(results)} 個 URL")
        else:
            print(f"\n✅ 完成：已修補 {len(results)} 個 URL")
        return

    # ── 獨立模式：--sync-board ──────────────
    if args.sync_board:
        print("🚀 executor.py — Project Board 同步模式")
        results = sync_board(dry_run=args.dry_run)
        added = sum(1 for r in results if r.get("added"))
        if args.dry_run:
            print(f"\n✅ [DRY RUN] 預計將加入 Board {len(results)} 個 Issues")
        else:
            print(f"\n✅ 完成：已加入 Board {added}/{len(results)} 個 Issues")
        return

    # ── 獨立模式：--pull-github ──────────────
    if args.pull_github:
        print("🚀 executor.py — GitHub Pull 模式")
        results = pull_github_issues_to_local(dry_run=args.dry_run)
        updated = sum(1 for r in results if r["updated"])
        if args.dry_run:
            print(f"\n✅ [DRY RUN] 預計將更新 {len(results)} 個任務")
        else:
            print(f"\n✅ 完成：已更新 {updated}/{len(results)} 個任務")
        return
    # ────────────────────────────────────────────────────────────────

    # ── 預設模式：掃描 Ideas/ → 建立 Tasks ──────────────────────────
    print("🚀 executor.py 啟動（直接掃描 Ideas/）")

    # 0. 統一歷史 Status 格式（可選）
    if args.normalize:
        from state_sync import normalize_all_task_statuses
        fixed = normalize_all_task_statuses()
        print(f"  🔧 修復 {fixed} 個 Status 格式")

    # 1. 掃描 Ideas/ 並建立 tasks
    created = create_tasks_from_ideas(dry_run=args.dry_run)

    # 2. GitHub 同步（可選）
    if args.github and created:
        print("\n🌐 同步 GitHub Issues...")
        gh_results = sync_tasks_to_github(created)
        gh_ok = sum(1 for r in gh_results if r["issue_url"])
        print(f"  ✅ {gh_ok}/{len(gh_results)} 個 Issue 已建立")

    # 3. 匯報
    if args.dry_run:
        print("\n[DRY RUN] 以下 tasks 將被建立：")
        for c in created:
            print(f"  {c['project']}/T{c['task_num']:03d} → {c['assignee']}")
        return

    report = build_telegram_report(created)
    print("\n" + report)

    # 4. 寫入執行狀態
    exec_status = {
        "timestamp": datetime.now().isoformat(),
        "created_count": len(created),
        "created": created,
    }
    exec_file = Path(__file__).parent / "executor_status.json"
    exec_file.write_text(json.dumps(exec_status, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"\n✅ 狀態已寫入 executor_status.json")

    # 5. 提示 spawn
    if not args.no_spawn and created:
        print("\n💡 提示：使用以下指令 spawn agents：")
        for c in created:
            agent_id = c["agent_id"]
            print(f"  sessions_spawn(agentId=\"{agent_id}\", task=\"執行 {c['project']}/T{c['task_num']:03d}: {c['title'][:40]}\")")


if __name__ == "__main__":
    main()
